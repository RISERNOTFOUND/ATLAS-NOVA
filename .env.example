# Copy this file to ".env" and fill in your values. ".env" is git-ignored — never commit it.

# ---- Bot Tokens (required unless using token.txt / token2.txt) ----
DISCORD_BOT_TOKEN=
DISCORD_BOT_TOKEN_2=

# ---- Ownership & Permissions ----
# Comma-separated Discord user IDs for bot owners
BOT_OWNER_IDS=
# Single Discord user ID allowed to run destructive moderation commands (!kick, !ban, etc.)
MODERATION_OWNER_ID=
# Optional shutdown phrase for owners
SHUTDOWN_PHRASE=bye good night

# ---- Prefixes & Branding ----
ATLAS_PREFIX=!
ATLAS_PREFIXES=!,?,.
NOVA_PREFIXES=!
EMBED_COLOR=0x5865F2

# ---- Feature Toggles (true / false) ----
FEATURE_VIBE=true
FEATURE_TTS=true
FEATURE_TICKETS=true
FEATURE_AUTOMOD=true
FEATURE_TEMPVOICE=true
FEATURE_ANALYTICS=true
FEATURE_ROLES=true
FEATURE_ONBOARDING=true
FEATURE_AI=true
FEATURE_FEEDS=true
FEATURE_LOGGING=true
FEATURE_VOICE=true
FEATURE_ENGAGEMENT=true
FEATURE_MODERATION=true

# ---- Server-Specific Channel / Role / Category IDs (leave empty or 0 to disable / auto-resolve) ----
VIBE_CHANNEL_ID=
VIBE_CHANNEL_NAME=vibe-check
DM_FORWARD_CHANNEL_ID=
PRESERVED_CHANNEL_ID=
LOG_CHANNEL_ID=
WELCOME_CHANNEL_ID=
VERIFICATION_CHANNEL_ID=
VERIFIED_ROLE_ID=
TICKET_CATEGORY_ID=
TEMPVOICE_CATEGORY_ID=
TEMPVOICE_LOBBY_CHANNEL_ID=

# ---- Optional Integrations ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- Local AI (LM Studio / OpenAI-compatible) ----
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_MODEL=gemma-4-e4b-it-uncensored
AI_ASSIGNABLE_ROLE_NAMES=Gamer,Artist,Creator,Collaborator,Music Lover

# ---- TTS Settings ----
TTS_RATE=175
TTS_MAX_CHARS=400
TTS_MAX_QUEUE=50

# ---- Timezone ----
COMMUNITY_TIMEZONE=Asia/Kolkata
